# Copy to .env at the repository root. Do not commit the copy.
# Frontend settings live in frontend/.env and may only use VITE_API_BASE_URL.

APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8091
AUTO_MIGRATE=true

DATABASE_URL=postgresql+psycopg://manualmind:manualmind@127.0.0.1:5432/manualmind
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_SSLMODE=prefer

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_ANSWERS=true

MCP_SERVER_URL=http://127.0.0.1:8092/mcp
MCP_SERVER_TOKEN=
MCP_TOOL_TIMEOUT_SECONDS=8
NODE_TIMEOUT_SECONDS=25
MCP_PORT=8092

CORS_ALLOWED_ORIGINS=http://127.0.0.1:4178,http://localhost:4178
CORS_ALLOW_VERCEL_PREVIEWS=true

# Leave empty in local development to use STORAGE_LOCAL_PATH.
# Production must set all four object-storage values. Do not use Vercel disk for uploads.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
STORAGE_LOCAL_PATH=.storage

SESSION_SECRET=dev-only-change-me
DEFAULT_TENANT_ID=demo
RETENTION_DAYS=365

SEED_DEMO_DATA=true
EMBED_WORKER=true
MAX_UPLOAD_BYTES=26214400

VECTOR_TOP_K=12
BM25_TOP_K=12
RRF_K=60
RRF_WEIGHT_VECTOR=1
RRF_WEIGHT_BM25=1
RERANK_POOL=12
RETURN_K=6
CONFIDENCE_HIGH=0.80
CONFIDENCE_MEDIUM=0.60
WEAK_RELEVANCE_THRESHOLD=0.35

CHUNK_TARGET_TOKENS=700
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
PROMPT_VERSION=answer-v1

# Optional live OEM adapter. A URL or token without a vetted schema is refused.
# Do not invent an endpoint here.
OEM_API_BASE_URL=
OEM_API_SCHEMA_VERSION=
OEM_API_TOKEN=

PUBLIC_BASE_URL=
