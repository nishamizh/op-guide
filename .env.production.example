# Placeholder values only. Put real secrets in the host's secret store, not in git.
# Frontend (Vercel project, root directory frontend/):
#   VITE_API_BASE_URL=https://api.example.com

APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8091
AUTO_MIGRATE=false

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db.example.com:5432/manualmind?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_SSLMODE=require

OPENAI_API_KEY=replace-with-secret-store-value
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_ANSWERS=true

MCP_SERVER_URL=https://mcp.example.com/mcp
MCP_SERVER_TOKEN=replace-with-secret-store-value
MCP_TOOL_TIMEOUT_SECONDS=8
NODE_TIMEOUT_SECONDS=25

CORS_ALLOWED_ORIGINS=https://manualmind.example.com
CORS_ALLOW_VERCEL_PREVIEWS=true

OBJECT_STORAGE_BUCKET=manualmind-documents
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_ACCESS_KEY=replace-with-secret-store-value
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-store-value
OBJECT_STORAGE_REGION=us-east-1

SESSION_SECRET=replace-with-secret-store-value
DEFAULT_TENANT_ID=demo
RETENTION_DAYS=365

SEED_DEMO_DATA=false
EMBED_WORKER=false
MAX_UPLOAD_BYTES=26214400
PROMPT_VERSION=answer-v1

OEM_API_BASE_URL=
OEM_API_SCHEMA_VERSION=
OEM_API_TOKEN=

PUBLIC_BASE_URL=https://api.example.com
